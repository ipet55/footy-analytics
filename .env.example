# Copy to .env and fill in. .env is gitignored.

# Supabase project (already created: Football_Analysis, eu-west-1)
SUPABASE_PROJECT_REF=wziypmmboifdudvhhlmj
SUPABASE_URL=https://wziypmmboifdudvhhlmj.supabase.co

# Postgres connection. Use the SESSION POOLER string from
# Supabase -> Project Settings -> Database -> Connection string -> URI,
# and replace [YOUR-PASSWORD] with your database password.
# Session pooler (port 5432) is required because ingestion uses COPY.
DATABASE_URL=

# Service role key — Supabase -> Project Settings -> API.
# Only needed for the REST fallback loader; the direct Postgres path is preferred.
SUPABASE_SERVICE_ROLE_KEY=

# Paid sources — not needed yet, leave blank.
API_FOOTBALL_KEY=
ODDS_API_KEY=
